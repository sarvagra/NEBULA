<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Glow behind the celestial body -->
    <path
        android:pathData="M 54,26 A 28,28 0 1,0 54,82 A 28,28 0 1,0 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:offset="0" android:color="#558B5CF6"/>
                <item android:offset="0.65" android:color="#206D28D9"/>
                <item android:offset="1" android:color="#0008070D"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tilted Planetary Ring (Back Arc & Full Path) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-24">
        <path
            android:strokeWidth="2.8"
            android:pathData="M 27,54 A 27,9.5 0 1,0 81,54 A 27,9.5 0 1,0 27,54 Z">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="27"
                    android:startY="45"
                    android:endX="81"
                    android:endY="63"
                    android:type="linear">
                    <item android:offset="0" android:color="#FF22D3EE"/>
                    <item android:offset="0.55" android:color="#FFA78BFA"/>
                    <item android:offset="1" android:color="#FFF472B6"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Celestial Orb Core -->
    <path
        android:pathData="M 54,38.5 A 15.5,15.5 0 1,0 54,69.5 A 15.5,15.5 0 1,0 54,38.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="49.5"
                android:centerY="48"
                android:gradientRadius="18.5"
                android:type="radial">
                <item android:offset="0" android:color="#FFFFFFFF"/>
                <item android:offset="0.42" android:color="#FFC4B5FD"/>
                <item android:offset="1" android:color="#FF6D28D9"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core Rim Highlight -->
    <path
        android:strokeWidth="1"
        android:strokeColor="#59FFFFFF"
        android:pathData="M 54,38.5 A 15.5,15.5 0 1,0 54,69.5 A 15.5,15.5 0 1,0 54,38.5 Z" />

    <!-- Foreground Ring Arc (Creates 3D Depth Across Planet) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-24">
        <path
            android:strokeWidth="2.8"
            android:pathData="M 33,56 A 27,9.5 0 0,0 75,56">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="33"
                    android:startY="50"
                    android:endX="75"
                    android:endY="62"
                    android:type="linear">
                    <item android:offset="0" android:color="#FF22D3EE"/>
                    <item android:offset="0.55" android:color="#FFA78BFA"/>
                    <item android:offset="1" android:color="#FFF472B6"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

</vector>
