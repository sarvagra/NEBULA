<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of res/xml/network_security_config.xml.

  Release builds keep the strict TLS configuration from the main source set. Debug
  builds need plain HTTP so the app can be pointed at a backend running on the
  developer machine (10.0.2.2 is the emulator's alias for the host).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
