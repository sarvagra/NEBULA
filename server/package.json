{
  "name": "nebula-server",
  "version": "1.0.0",
  "description": "Nebula Realtime Social & Room Sync Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:security",
    "test:security": "ts-node-dev --transpile-only src/tests/securityTests.ts",
    "test:db": "ts-node-dev --transpile-only src/tests/connectivityTest.ts",
    "test:firebase": "ts-node-dev --transpile-only src/tests/firebaseAuthFlowTest.ts",
    "test:sync": "ts-node-dev --transpile-only src/tests/multiClientSyncTest.ts"
  },
  "keywords": [
    "nebula",
    "rooms",
    "sync",
    "social",
    "realtime"
  ],
  "author": "Nebula Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^9.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "nodemailer": "^10.1.0",
    "resend": "^6.32.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
